# NoInsta Backend Server Configuration

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://noinsta_user:noinsta_password@localhost:5432/noinsta

# Cryptographic Keys (Change in production!)
JWT_SECRET=noinsta_super_secret_jwt_key_change_in_production_min_32_bytes
JWT_ALGORITHM=HS256

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Pairing Code Configuration
PAIRING_CODE_EXPIRE_MINUTES=10
PAIRING_CODE_MAX_ATTEMPTS=5

# Cooldown & Presence Thresholds
INSTAGRAM_COOLDOWN_SECONDS=300
LAPTOP_HEARTBEAT_SECONDS=120
LAPTOP_OFFLINE_SECONDS=900

# Server Environment & Security
APP_ENV=development
ALLOWED_ORIGINS=https://noinsta.platesight.in
RATE_LIMIT_PER_MINUTE=60
